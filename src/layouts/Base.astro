---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  /** Optional override. Normally the canonical is derived from the route. */
  canonical?: string;
  /** Transparent header, for the landing page hero only. */
  transparentHeader?: boolean;
  /** JSON-LD object, serialised into a script tag. */
  schema?: Record<string, unknown> | null;
}

const {
  title,
  description,
  canonical,
  transparentHeader = false,
  schema = null,
} = Astro.props;

/* Self-referencing canonical, derived from the route rather than passed in,
   so a page cannot declare the wrong one. Astro.url.pathname already carries
   the .html because build.format is 'file', and it never carries a query
   string or hash in a static build. The homepage is the one exception: it is
   emitted as index.html but is canonically the bare origin, which is what is
   indexed and what the sitemap lists. */
const routePath = Astro.url.pathname.replace(/index\.html$/, '');
const canonicalUrl = new URL(canonical ?? routePath, Astro.site).href;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" href="/assets/img/favicon.png" type="image/png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=Jost:wght@300;400;500&display=swap"
    rel="stylesheet"
  />

  <slot name="head" />

  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}
</head>
<body>
  <Header transparent={transparentHeader} current={canonical ?? routePath} />

  <slot />

  <Footer />

  <script src="/site.js" is:inline defer></script>
</body>
</html>
