---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Cta from '../components/Cta.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": "https://lathrem-home-builders-com.vercel.app/#business",
  "name": "Lathrem Homebuilders, LLC",
  "alternateName": "Lathrem Homebuilders",
  "description": "Licensed Arizona general contractor building custom homes, remodels, additions and outdoor living throughout Tucson and Pima County.",
  "url": "https://lathrem-home-builders-com.vercel.app/",
  "logo": "https://lathrem-home-builders-com.vercel.app/assets/img/logo-c.png",
  "image": "https://lathrem-home-builders-com.vercel.app/assets/img/hero2-2400.webp",
  "telephone": "+1-520-975-0456",
  "founder": {
    "@type": "Person",
    "name": "Charles Lathrem"
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "4032 W Moore Rd",
    "addressLocality": "Tucson",
    "addressRegion": "AZ",
    "postalCode": "85742",
    "addressCountry": "US"
  },
  "identifier": {
    "@type": "PropertyValue",
    "name": "Arizona ROC license",
    "value": "324057"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "bestRating": "5",
    "reviewCount": "19"
  },
  "areaServed": [
    {
      "@type": "AdministrativeArea",
      "name": "Pima County, Arizona"
    },
    {
      "@type": "City",
      "name": "Tucson, Arizona"
    },
    {
      "@type": "City",
      "name": "Oro Valley, Arizona"
    },
    {
      "@type": "City",
      "name": "Marana, Arizona"
    },
    {
      "@type": "Place",
      "name": "Catalina Foothills, Arizona"
    },
    {
      "@type": "Place",
      "name": "Casas Adobes, Arizona"
    },
    {
      "@type": "Place",
      "name": "Tortolita, Arizona"
    }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Construction services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Custom Homes"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Remodels & Additions"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Outdoor Living & Pools"
        }
      }
    ]
  },
  "sameAs": [
    "https://www.houzz.com/professionals/home-builders/lathrem-homebuilders-llc-pfvwus-pf~218754289"
  ]
};
---

<Base
  title="Lathrem Homebuilders | Custom Homes & Remodels in Tucson, Arizona"
  description="Lathrem Homebuilders is a licensed Tucson custom home builder specializing in desert residences, remodels, additions and outdoor living across Southern Arizona."
  canonical="/"
  transparentHeader={true}
  schema={schema}
>
  <!-- Discover the hero before the stylesheet resolves. These five WebP files
       are hand-tuned for LCP and live in public/, so astro:assets leaves them
       alone; regenerating them here would risk the metric, not improve it. -->
  <link
    slot="head"
    rel="preload" as="image" type="image/webp" fetchpriority="high"
    imagesrcset="/assets/img/hero2-480.webp 480w,
                 /assets/img/hero2-800.webp 800w,
                 /assets/img/hero2-1200.webp 1200w,
                 /assets/img/hero2-1600.webp 1600w,
                 /assets/img/hero2-2400.webp 2400w"
    imagesizes="100vw"
  />

  <section class="hero">
    <div class="hero__media">
      <picture>
        <source
          type="image/webp"
          srcset="/assets/img/hero2-480.webp 480w,
                  /assets/img/hero2-800.webp 800w,
                  /assets/img/hero2-1200.webp 1200w,
                  /assets/img/hero2-1600.webp 1600w,
                  /assets/img/hero2-2400.webp 2400w"
          sizes="100vw"
        />
        <img
          src="/assets/img/hero2-2400.jpg"
          srcset="/assets/img/hero2-800.jpg 800w, /assets/img/hero2-2400.jpg 2400w"
          sizes="100vw"
          width="2400" height="1603"
          loading="eager" fetchpriority="high" decoding="async"
          alt="A custom desert contemporary home at twilight, its stacked-stone piers and lit glass walls standing behind a saguaro and desert garden"
        />
      </picture>
    </div>
    <div class="hero__scrim"></div>

    <div class="hero__inner">
      <h1 class="hero__quote">The Details of Excellence</h1>
      <p class="hero__sub">Custom homes, remodels and outdoor living built into the Sonoran Desert of Tucson, Oro Valley, Marana and the Catalina Foothills.</p>
      <p class="hero__cta"><a class="link link--light" href="/portfolio.html">See the work <span class="arw">&rarr;</span></a></p>
    </div>

    <div class="hero__scroll" aria-hidden="true">Scroll<i></i></div>
  </section>

  <!-- ================= STATEMENT ================= -->
  <section class="section">
    <div class="wrap">
      <div class="statement rv">
        <p class="eyebrow">Tucson, Arizona</p>
        <h2 class="display h-lg">Truly superior homes are built by people of high character.</h2>
        <p class="lede">Lathrem Homebuilders is not a typical construction company. Decades of experience across every phase of the build, paired with a genuine appreciation for a wide range of design styles, let us deliver results that hold up to close inspection. We treat every project as if it were our own, and we stand behind everything we say and do.</p>
        <p style="margin-top:34px"><a class="link" href="/about.html">About the company <span class="arw">&rarr;</span></a></p>
      </div>

      <div class="stats rv rv-d1">
        <div class="stat">
          <div class="stat__n">Top 1%</div>
          <div class="stat__l">of Arizona<br>licensed contractors</div>
          <div class="stat__src">BuildZoom score 120</div>
        </div>
        <div class="stat">
          <div class="stat__n">5.0</div>
          <div class="stat__l">average<br>client rating</div>
          <div class="stat__src">19 reviews on Houzz</div>
        </div>
        <div class="stat">
          <div class="stat__n">AZ ROC</div>
          <div class="stat__l">licensed &amp; bonded<br>general contractor</div>
          <div class="stat__src">License #324057, active</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= FEATURED PROJECT ================= -->
  <section class="section section--warm">
    <div class="wrap">
      <div class="feature">
        <a class="feature__media rv" href="/portfolio.html">
          <Photo src="feature-sunset.jpg" alt="An elevated infinity pool with a fire bowl burning at its edge, set against a covered portal and a pink desert sunset" />
        </a>
        <div class="feature__body rv rv-d1">
          <p class="eyebrow">Featured project</p>
          <h2 class="display h-md">The elevated pool</h2>
          <p class="lede">An infinity pool lifted clear of the desert floor on a curved travertine wall, with a fire bowl burning at the coping and a columned portal glowing behind it. The spa takes its own terrace to the side, and the whole arrangement is set into the boulders rather than cut out of them. Built for the twenty minutes either side of sundown.</p>
          <div class="feature__meta">
            <div><span>Discipline</span><span>Custom home &amp; outdoor living</span></div>
            <div><span>Features</span><span>Elevated pool, fire bowl &amp; spa</span></div>
            <div><span>Setting</span><span>Sonoran Desert, Southern Arizona</span></div>
          </div>
          <a class="link" href="/portfolio.html">View the portfolio <span class="arw">&rarr;</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PORTFOLIO GRID ================= -->
  <section class="section">
    <div class="wrap">
      <div class="grid-head rv">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2 class="display h-lg" style="max-width:16ch">A portfolio built one detail at a time.</h2>
        </div>
        <a class="link" href="/portfolio.html">All projects <span class="arw">&rarr;</span></a>
      </div>

      <div class="grid rv rv-d1">
        <!-- lead tile, full bleed across the grid -->
        <a class="tile tile--full tile--a2110" href="/portfolio.html">
          <Photo src="dc-pool-dusk.jpg" alt="Curved contemporary home and infinity pool glowing at dusk" />
          <span class="tile__cap"><span class="tile__t">Southwest Contemporary</span><span class="tile__s">Custom home</span></span>
        </a>

        <!-- row of three -->
        <a class="tile tile--a43" href="/portfolio.html">
          <Photo src="tr-courtyard.jpg" alt="Courtyard pool and covered ramada framed by mountain views" />
          <span class="tile__cap"><span class="tile__t">Courtyard &amp; Ramada</span><span class="tile__s">Outdoor living</span></span>
        </a>
        <a class="tile tile--a43" href="/portfolio.html">
          <Photo src="sg-kitchen.jpg" alt="Contemporary kitchen with a mountain view through a full-width window" />
          <span class="tile__cap"><span class="tile__t">Kitchen &amp; Mountain View</span><span class="tile__s">Interior</span></span>
        </a>
        <a class="tile tile--a43" href="/portfolio.html">
          <Photo src="ow-estate.jpg" alt="Old-world estate at sunset below a rock outcrop" />
          <span class="tile__cap"><span class="tile__t">Old-World Estate</span><span class="tile__s">Custom home</span></span>
        </a>

        <!-- row of three -->
        <a class="tile tile--a43" href="/portfolio.html">
          <Photo src="rg-fire-pool.jpg" alt="Fire feature burning beside a curved pool at dusk" />
          <span class="tile__cap"><span class="tile__t">Fire Bowl &amp; Pool</span><span class="tile__s">Outdoor living</span></span>
        </a>
        <a class="tile tile--a43" href="/portfolio.html">
          <Photo src="dc-bath.jpg" alt="Master bath with a soaking tub set into a curved window wall" />
          <span class="tile__cap"><span class="tile__t">Curved Bath</span><span class="tile__s">Interior</span></span>
        </a>
        <a class="tile tile--a43" href="/portfolio.html">
          <Photo src="tr-fountain.jpg" alt="Circular stone fountain in a desert entry courtyard" />
          <span class="tile__cap"><span class="tile__t">Entry Courtyard</span><span class="tile__s">Site work</span></span>
        </a>

        <!-- closing pair -->
        <a class="tile tile--half tile--a169" href="/portfolio.html">
          <Photo src="dc-patio-dusk.jpg" alt="Covered patio and stacked-stone piers lit from within at twilight" />
          <span class="tile__cap"><span class="tile__t">Evening Terrace</span><span class="tile__s">Outdoor living</span></span>
        </a>
        <a class="tile tile--half tile--a169" href="/portfolio.html">
          <Photo src="sg-living.jpg" alt="Living room with a stone chimney wall opening onto the desert" />
          <span class="tile__cap"><span class="tile__t">Stone Hearth Wall</span><span class="tile__s">Great room</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= SERVICES ================= -->
  <section class="section section--warm">
    <div class="wrap">
      <div class="grid-head rv">
        <div>
          <p class="eyebrow">What we build</p>
          <h2 class="display h-lg">Three ways we work.</h2>
        </div>
      </div>

      <div class="svc">
        <div class="svc__i rv">
          <div class="svc__n">01</div>
          <h3>Custom Homes</h3>
          <p>Ground-up residences designed around the site and the way you actually live in it, from desert contemporary to territorial and old-world. We partner with your architect from the first grading plan through the final walkthrough.</p>
        </div>
        <div class="svc__i rv rv-d1">
          <div class="svc__n">02</div>
          <h3>Remodels &amp; Additions</h3>
          <p>Kitchens, baths, whole-home renovations, guest houses and additions. The hardest part of remodeling is making new work look like it was always there. That's the part we care about most.</p>
        </div>
        <div class="svc__i rv rv-d2">
          <div class="svc__n">03</div>
          <h3>Outdoor Living &amp; Pools</h3>
          <p>Ramadas, courtyards, outdoor kitchens, fire features, custom pools and spas. In Southern Arizona the exterior rooms get used year-round, so we build them to the same standard as the interior.</p>
        </div>
      </div>
    </div>
  </section>

  <Cta
    heading="Ready to build something that lasts?"
    body="Tell us about the site, the scope and the timeline. We will tell you honestly whether we are the right builder for it."
    image="dc-walk-dusk.jpg"
  />
</Base>
