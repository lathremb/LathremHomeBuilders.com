# Environment variables for /api/contact
#
# These are set in Vercel (Project > Settings > Environment Variables), NOT in
# a file that gets deployed. Nothing here reaches the browser.
#
# Copy to .env.local only if you want to run `vercel dev` locally.

# From https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where website inquiries should land
CONTACT_EMAIL=lathrem@gmail.com

# Optional. Resend's shared sender (the default below) only delivers to the
# address that owns the Resend account, which is fine while CONTACT_EMAIL is
# your own inbox. Once you verify a domain in Resend, change this to something
# like "Website <website@lathremhomebuilders.com>" so it can send anywhere and
# lands in fewer spam folders.
CONTACT_FROM=Lathrem Website <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Supabase - stores every contact submission before the email is attempted,
# so a lead is never lost to a delivery failure. Both optional: without them
# the form still emails exactly as before.
#
# Project: client-Lathrem-Homebuilders (us-west-1)
SUPABASE_URL=https://yguoqmqmoizzfiaqragi.supabase.co

# Service role key. It BYPASSES row level security, so it is server-side only
# and must never appear in the browser or be committed. Supabase dashboard >
# Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
